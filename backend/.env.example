# Backend Environment Example Template for Sportsman.ke Monorepo
# Use this as reference when setting environment variables in production platforms (Render, Railway, Fly.io)

NODE_ENV=production
PORT=3000
BACKEND_URL=https://your-backend-api.onrender.com

# Database (Supabase PostgreSQL Connection Pooler)
DB_TYPE=postgres
DB_SSL=true
DB_HOST=aws-1-us-west-2.pooler.supabase.com
DB_PORT=6543
DB_USERNAME=postgres.your_project_ref
DB_PASSWORD=your_supabase_db_password
DB_DATABASE=postgres

# Security (JWT secret for signing user tokens)
JWT_SECRET=your_strong_random_256bit_jwt_secret

# CORS Allowed Origins (Comma-separated)
ALLOWED_ORIGINS=https://sportsman.ke,https://sportsman-frontend.vercel.app

# Supabase Object Storage (For product image uploads)
SUPABASE_URL=https://your_project_ref.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_role_key
SUPABASE_STORAGE_BUCKET=product-images

# SMTP Email Configuration (Nodemailer verification emails & receipts)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM="Sportsman.ke" <your_email@gmail.com>

# Safaricom Daraja M-Pesa Integration Credentials
MPESA_API_URL=https://api.safaricom.co.ke
MPESA_CONSUMER_KEY=your_production_consumer_key
MPESA_CONSUMER_SECRET=your_production_consumer_secret
MPESA_SHORTCODE=your_till_or_paybill
MPESA_PASSKEY=your_production_passkey
MPESA_CALLBACK_URL=https://your-backend-api.onrender.com/api/mpesa/callback
