# Frontend Environment Configuration (Vite + Vercel + Supabase)

# Production Backend API URL (Vercel Serverless / Render / Railway)
VITE_API_URL=https://your-backend-api.onrender.com/api

# Supabase Client Settings (Optional frontend direct connection)
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Web3Forms Access Key for Contact Support Modal (https://web3forms.com)
VITE_WEB3FORMS_ACCESS_KEY=your_web3forms_access_key_here
